# Proxy de desarrollo de la tienda (en producción esto lo hacen las funciones api/ en Vercel)
PORT=4000
# URL del API del admin (fuente de verdad)
ADMIN_API_URL=http://localhost:4500

# Mismo valor que STORE_PROXY_SECRET en el admin: autentica este proxy para que
# el admin confíe en la IP del comprador que le reenviamos.
STORE_PROXY_SECRET=
